GITHUB_TOKEN=

APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Comma-separated origins allowed to call the API when deployed, e.g. https://your-domain.example
CORS_ORIGINS=

DB_PATH=./data/stockveda.duckdb

NSE_BASE_URL=https://archives.nseindia.com
SYNC_TIMEOUT_SECONDS=30
# Days of NSE price history to fetch on the first price sync (and to backfill into an older database)
BHAVCOPY_LOOKBACK_DAYS=400
